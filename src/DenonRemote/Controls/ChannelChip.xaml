<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DenonRemote.Controls">

    <Style TargetType="{x:Type controls:ChannelChip}">
        <Setter Property="Width" Value="52" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ChannelChip}">
                    <Border
                        x:Name="Root"
                        Background="{StaticResource IdleSpeakerBrush}"
                        BorderBrush="Transparent"
                        BorderThickness="1"
                        CornerRadius="5"
                        SnapsToDevicePixels="True">
                        <TextBlock
                            x:Name="Label"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource ChannelIdleTextBrush}"
                            Text="{Binding Channel.Label, RelativeSource={RelativeSource TemplatedParent}}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Input signal mode: red when the incoming signal contains this channel -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Mode, RelativeSource={RelativeSource Self}}" Value="InputSignal" />
                                <Condition Binding="{Binding Channel.IsInputActive, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource ActiveSpeakerBrush}" />
                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource ChannelActiveTextBrush}" />
                        </MultiDataTrigger>
                        <!-- Active speaker mode: red when the physical speaker is playing -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Mode, RelativeSource={RelativeSource Self}}" Value="ActiveSpeaker" />
                                <Condition Binding="{Binding Channel.IsSpeakerActive, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource ActiveSpeakerBrush}" />
                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource ChannelActiveTextBrush}" />
                            <Setter Property="Cursor" Value="Hand" />
                        </MultiDataTrigger>
                        <!-- Hover halo on active speaker chips -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Mode, RelativeSource={RelativeSource Self}}" Value="ActiveSpeaker" />
                                <Condition Binding="{Binding Channel.IsSpeakerActive, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Root" Property="BorderBrush" Value="White" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
