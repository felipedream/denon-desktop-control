<ui:FluentWindow
    x:Class="DenonRemote.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:DenonRemote.Views.Pages"
    xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="DENON Desktop Control"
    Width="1200"
    Height="820"
    MinWidth="980"
    MinHeight="640"
    Background="#0B0D11"
    ExtendsContentIntoTitleBar="True"
    FontFamily="Segoe UI Variable, Segoe UI"
    Foreground="{StaticResource TextPrimaryBrush}"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Views/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Title="DENON Desktop Control"
            CanMaximize="True"
            ShowMaximize="True"
            ShowMinimize="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/Assets/app.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ui:NavigationView
            x:Name="Nav"
            Grid.Row="1"
            Background="Transparent"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleVisible="True"
            OpenPaneLength="220"
            PaneDisplayMode="Left"
            Loaded="OnNavLoaded">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem x:Name="NavHome" TargetPageType="{x:Type pages:DashboardPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="HomeMore24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="NavSources" TargetPageType="{x:Type pages:SourcesPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="AppsList24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="NavSound" TargetPageType="{x:Type pages:SoundPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="MusicNote124" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="NavHeos" TargetPageType="{x:Type pages:HeosPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="MusicNote224" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="NavDevices" TargetPageType="{x:Type pages:ConnectPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="PlugConnected24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem x:Name="NavSettings" TargetPageType="{x:Type pages:SettingsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>

            <!-- â”€â”€ Recent devices shortcut list â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            <ui:NavigationView.PaneFooter>
                <StackPanel Margin="12,0,12,12">
                    <TextBlock
                        Margin="4,10,0,6"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextTertiaryBrush}"
                        x:Name="RecentLabel"
                        Visibility="{Binding RecentDevices.Count, Converter={StaticResource NotNullToBool}}" />
                    <ItemsControl ItemsSource="{Binding RecentDevices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Margin="0,2"
                                    Padding="8,8"
                                    HorizontalContentAlignment="Stretch"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding DataContext.ConnectToRecentCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                    CommandParameter="{Binding}"
                                    Cursor="Hand"
                                    Focusable="False">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                x:Name="Root"
                                                Padding="{TemplateBinding Padding}"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border
                                                        Width="26"
                                                        Height="26"
                                                        VerticalAlignment="Center"
                                                        Background="{StaticResource AccentBrush}"
                                                        CornerRadius="6">
                                                        <ui:SymbolIcon
                                                            FontSize="14"
                                                            Foreground="White"
                                                            Symbol="Speaker224" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock
                                                            FontSize="12"
                                                            FontWeight="SemiBold"
                                                            Foreground="{StaticResource TextPrimaryBrush}"
                                                            Text="{Binding FriendlyName}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            FontSize="10"
                                                            Foreground="{StaticResource TextTertiaryBrush}"
                                                            Text="{Binding Host}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource Surface2Brush}" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource Surface1Brush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:NavigationView.PaneFooter>
        </ui:NavigationView>

        <!-- â”€â”€ Status bar â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
        <Border
            Grid.Row="2"
            Padding="20,14"
            Background="#111318"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="180" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse
                        Width="10"
                        Height="10"
                        VerticalAlignment="Center"
                        Fill="{Binding State.IsConnected, Converter={StaticResource ChannelBg}}" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Text="{Binding State.FriendlyName}" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="{Binding State.IpAddress}" />
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Column="1" Margin="28,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="52" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="18"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Symbol="Speaker224" />
                    <Slider
                        Grid.Column="1"
                        Margin="12,0"
                        VerticalAlignment="Center"
                        IsMoveToPointEnabled="True"
                        LargeChange="1"
                        Maximum="150"
                        Minimum="0"
                        SmallChange="0.5"
                        Value="{Binding State.Main.Volume, Mode=TwoWay, Delay=200}" />
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock
                            HorizontalAlignment="Right"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{Binding State.Main.IsMuted, Converter={StaticResource MuteBrush}}"
                            Text="{Binding State.Main.Volume, Converter={StaticResource VolumeLabel}}" />
                        <TextBlock
                            HorizontalAlignment="Right"
                            FontSize="9"
                            FontWeight="Bold"
                            Foreground="{StaticResource AccentBrush}"
                            Text="MUTE"
                            Visibility="{Binding State.Main.IsMuted, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Grid>

                <ui:Button
                    Grid.Column="2"
                    Margin="0,0,8,0"
                    Command="{Binding MuteToggleCommand}"
                    ToolTip="Silenciar / Reactivar">
                    <ui:SymbolIcon
                        FontSize="18"
                        Foreground="{Binding State.Main.IsMuted, Converter={StaticResource MuteBrush}}"
                        Symbol="{Binding State.Main.IsMuted, Converter={StaticResource MuteIcon}}" />
                </ui:Button>
                <ui:Button
                    Grid.Column="3"
                    Appearance="Primary"
                    Command="{Binding PowerToggleCommand}"
                    Icon="{ui:SymbolIcon Power24}"
                    ToolTip="Power (toggle)" />
            </Grid>
        </Border>

        <!-- Tray icon: sits outside the layout flow (0Ã—0). Kept in the visual
             tree so it inherits DataContext without extra plumbing. -->
        <tb:TaskbarIcon
            x:Name="Tray"
            Grid.Row="0"
            Grid.RowSpan="3"
            Width="0"
            Height="0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IconSource="/Assets/app.ico"
            NoLeftClickDelay="True"
            ToolTipText="Denon Remote"
            TrayMouseDoubleClick="OnTrayDoubleClick"
            TrayLeftMouseUp="OnTrayLeftClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Click="OnShowWindow" Header="Show window" />
                    <Separator />
                    <MenuItem Command="{Binding PowerToggleCommand}" Header="Power (toggle)" />
                    <MenuItem Command="{Binding MuteToggleCommand}" Header="Mute (toggle)" />
                    <MenuItem Command="{Binding VolumeUpCommand}" Header="Volume +" />
                    <MenuItem Command="{Binding VolumeDownCommand}" Header="Volume â€“" />
                    <Separator />
                    <MenuItem Click="OnQuit" Header="Quit" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</ui:FluentWindow>



