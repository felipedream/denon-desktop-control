<pages:PageBase
    x:Class="DenonRemote.Views.Pages.ConnectPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:DenonRemote.Views.Pages"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    mc:Ignorable="d">

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="HeroTitle" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock x:Name="HeroSubtitle" Style="{StaticResource Subtitle}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- ── Discovered devices (only this list scrolls) ────────────── -->
            <Border Grid.Column="0" Margin="0,0,6,0" Padding="18" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header row -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="DiscTitle" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{StaticResource TextTertiaryBrush}"
                                Text="{Binding StatusMessage}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToVis}}" />
                        </StackPanel>
                        <ui:Button
                            x:Name="RescanBtn"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Command="{Binding RefreshDevicesCommand}"
                            Icon="{ui:SymbolIcon ArrowSync24}" />
                    </Grid>

                    <!-- Device list: the only scrollable region on the page -->
                    <ListBox
                        Grid.Row="1"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{Binding Devices}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        SelectedItem="{Binding SelectedDevice}">
                        <ListBox.Resources>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10" />
                                <Setter Property="Margin" Value="0,3" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border
                                                x:Name="Root"
                                                Padding="{TemplateBinding Padding}"
                                                Background="Transparent"
                                                BorderBrush="{StaticResource CardBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource Surface2Brush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource Surface2Brush}" />
                                                    <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                    <Setter TargetName="Root" Property="BorderThickness" Value="2" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.Resources>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Width="40"
                                        Height="40"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource AccentBrush}"
                                        CornerRadius="10">
                                        <ui:SymbolIcon FontSize="20" Foreground="White" Symbol="Speaker224" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource TextPrimaryBrush}"
                                            Text="{Binding FriendlyName}" />
                                        <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                            <Run Text="{Binding Model}" />
                                            <Run Text=" - " />
                                            <Run Text="{Binding Host}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty state overlays the list area when nothing found -->
                    <StackPanel
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Devices.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border
                            Width="64"
                            Height="64"
                            Background="{StaticResource Surface2Brush}"
                            CornerRadius="32">
                            <ui:SymbolIcon FontSize="30" Foreground="{StaticResource TextTertiaryBrush}" Symbol="Speaker224" />
                        </Border>
                        <TextBlock
                            x:Name="EmptyTitle"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock
                            x:Name="EmptyDesc"
                            Margin="0,3,0,0"
                            HorizontalAlignment="Center"
                            FontSize="11"
                            Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>

                    <ui:Button
                        x:Name="ConnectBtn"
                        Grid.Row="2"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Right"
                        Appearance="Primary"
                        Command="{Binding ConnectCommand}"
                        Icon="{ui:SymbolIcon PlugConnected24}"
                        IsEnabled="{Binding SelectedDevice, Converter={StaticResource NotNullToBool}}" />
                </Grid>
            </Border>

            <!-- ── Right column: add by IP + help ────────────────────────── -->
            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                <Border Margin="0,0,0,12" Padding="18" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="IpTitle" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock x:Name="IpDesc" Margin="0,2,0,12" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" TextWrapping="Wrap" />
                        <ui:TextBox
                            Margin="0,0,0,8"
                            Padding="11,9"
                            FontSize="13"
                            PlaceholderText="192.168.1.82"
                            Text="{Binding ManualHost, UpdateSourceTrigger=PropertyChanged}">
                            <ui:TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding AddManualCommand}" />
                            </ui:TextBox.InputBindings>
                        </ui:TextBox>
                        <ui:Button
                            x:Name="AddBtn"
                            HorizontalAlignment="Stretch"
                            Appearance="Primary"
                            Command="{Binding AddManualCommand}"
                            Icon="{ui:SymbolIcon Add24}" />
                    </StackPanel>
                </Border>

                <Border Padding="16" Style="{StaticResource InsetCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="{StaticResource AccentBrush}"
                                Symbol="Info24" />
                            <TextBlock
                                x:Name="HelpTitle"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                        <TextBlock
                            x:Name="HelpDesc"
                            Margin="0,8,0,0"
                            FontSize="11"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</pages:PageBase>
