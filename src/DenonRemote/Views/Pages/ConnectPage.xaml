<pages:PageBase
    x:Class="DenonRemote.Views.Pages.ConnectPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="clr-namespace:DenonRemote.Views.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    FontFamily="Segoe UI Variable, Segoe UI"
    mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="40,32,40,32" MaxWidth="720" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Hero -->
            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock x:Name="HeroTitle" Style="{StaticResource H1}" Text="Add a receiver" />
                <TextBlock
                    Margin="0,6,0,0"
                    x:Name="HeroSubtitle" Style="{StaticResource Subtitle}" Text="Any Denon or Marantz on the same network." />
            </StackPanel>

            <!-- Discovered devices card -->
            <Border Grid.Row="1" Margin="0,0,0,16" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="DiscTitle" Style="{StaticResource H2}" Text="Discovered devices" />
                            <TextBlock
                                Margin="0,2,0,0"
                                Style="{StaticResource Subtitle}"
                                Text="{Binding StatusMessage}"
                                Visibility="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToVis}}" />
                        </StackPanel>
                        <ui:Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Command="{Binding RefreshDevicesCommand}"
                            Content="Rescan"
                            Icon="{ui:SymbolIcon ArrowSync24}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolToVis}}" />
                    </Grid>

                    <!-- Device list -->
                    <ListBox
                        Grid.Row="1"
                        MinHeight="180"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{Binding Devices}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectedItem="{Binding SelectedDevice}"
                        Visibility="{Binding Devices.Count, Converter={StaticResource NotNullToBool}}">
                        <ListBox.Resources>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10" />
                                <Setter Property="Margin" Value="0,4" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border
                                                x:Name="Root"
                                                Padding="{TemplateBinding Padding}"
                                                Background="Transparent"
                                                BorderBrush="{StaticResource CardBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource Surface2Brush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource Surface2Brush}" />
                                                    <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                    <Setter TargetName="Root" Property="BorderThickness" Value="2" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.Resources>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Width="44"
                                        Height="44"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource AccentBrush}"
                                        CornerRadius="10">
                                        <ui:SymbolIcon
                                            Foreground="White"
                                            FontSize="22"
                                            Symbol="Speaker224" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource TextPrimaryBrush}"
                                            Text="{Binding FriendlyName}" />
                                        <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                                            <Run Text="{Binding Model}" />
                                            <Run Text=" Â· " />
                                            <Run Text="{Binding Host}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty state -->
                    <StackPanel
                        Grid.Row="1"
                        Height="180"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Devices.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border
                            Width="72"
                            Height="72"
                            Background="{StaticResource Surface2Brush}"
                            CornerRadius="36">
                            <ui:SymbolIcon
                                FontSize="34"
                                Foreground="{StaticResource TextTertiaryBrush}"
                                Symbol="Speaker224" />
                        </Border>
                        <TextBlock
                            Margin="0,14,0,0"
                            HorizontalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Text="Nothing here yet" />
                        <TextBlock
                            Margin="0,4,0,0"
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="Press Rescan or add the IP manually below." />
                    </StackPanel>

                    <!-- Connect button -->
                    <ui:Button
                        Grid.Row="2"
                        Margin="0,14,0,0"
                        HorizontalAlignment="Right"
                        Appearance="Primary"
                        Command="{Binding ConnectCommand}"
                        Content="Connect"
                        Icon="{ui:SymbolIcon PlugConnected24}"
                        IsEnabled="{Binding SelectedDevice, Converter={StaticResource NotNullToBool}}" />
                </Grid>
            </Border>

            <!-- Add manually -->
            <Border Grid.Row="2" Margin="0,0,0,16" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock x:Name="IpTitle" Style="{StaticResource H2}" Text="Add by IP" />
                    <TextBlock
                        Margin="0,2,0,14"
                        x:Name="IpDesc" Style="{StaticResource Subtitle}" Text="Type the receiver's IP if it didn't appear above." />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox
                            Padding="12,10"
                            FontSize="14"
                            PlaceholderText="e.g. 192.168.1.82"
                            Text="{Binding ManualHost, UpdateSourceTrigger=PropertyChanged}">
                            <ui:TextBox.InputBindings>
                                <KeyBinding Command="{Binding AddManualCommand}" Key="Return" />
                            </ui:TextBox.InputBindings>
                        </ui:TextBox>
                        <ui:Button
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            Appearance="Primary"
                            Command="{Binding AddManualCommand}"
                            Content="Add and connect"
                            Icon="{ui:SymbolIcon Add24}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Helper hint -->
            <Border Grid.Row="3" Style="{StaticResource InsetCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon
                        VerticalAlignment="Top"
                        FontSize="20"
                        Foreground="{StaticResource AccentBrush}"
                        Symbol="Info24" />
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock x:Name="HelpTitle" Style="{StaticResource Body}" Text="Doesn't show up?" />
                        <TextBlock
                            Margin="0,4,0,0"
                            x:Name="HelpDesc"
                            Style="{StaticResource Subtitle}"
                            TextWrapping="Wrap"
                            Text="Make sure Network Standby is enabled on the receiver, and that your PC and the AVR are on the same subnet. UPnP / SSDP is used for discovery." />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</pages:PageBase>




