<pages:PageBase
    x:Class="DenonRemote.Views.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DenonRemote.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:DenonRemote.Views.Pages"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    mc:Ignorable="d">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="1200">

            <!-- ── Header ─────────────────────────────────────────────────── -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock
                        FontSize="12"
                        Foreground="{StaticResource TextTertiaryBrush}"
                        Text="{Binding State.ModelName, StringFormat='DENON · {0}'}" />
                    <TextBlock Style="{StaticResource H1}" Text="{Binding State.FriendlyName}" />
                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                        <Ellipse
                            Width="8"
                            Height="8"
                            VerticalAlignment="Center"
                            Fill="{Binding State.IsConnected, Converter={StaticResource ChannelBg}}" />
                        <TextBlock
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="{Binding State.IpAddress}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button
                        Margin="0,0,8,0"
                        Command="{Binding MuteToggleCommand}"
                        Icon="{ui:SymbolIcon SpeakerMute24}"
                        ToolTip="Mute" />
                    <ui:Button
                        Appearance="Primary"
                        Command="{Binding PowerToggleCommand}"
                        Content="Power"
                        Icon="{ui:SymbolIcon Power24}" />
                </StackPanel>
            </Grid>

            <!-- ── Metrics strip (clickable cards) ─────────────────────────── -->
            <UniformGrid Columns="4" Margin="0,0,0,20" Rows="1">
                <!-- Volume -->
                <Border Margin="0,0,6,0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="VOLUME" />
                        <TextBlock Style="{StaticResource MetricValue}" Text="{Binding State.Main.Volume, Converter={StaticResource VolumeLabel}}" />
                    </StackPanel>
                </Border>
                <!-- Source (clickable → opens source selector popup) -->
                <Border Margin="6,0,6,0" Style="{StaticResource Card}" Cursor="Hand" MouseLeftButtonUp="OnSourceCardClick">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="SOURCE" />
                        <TextBlock FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Text="{Binding State.Main.SourceFriendly}" />
                    </StackPanel>
                </Border>
                <!-- Surround (clickable → opens surround mode popup) -->
                <Border Margin="6,0,6,0" Style="{StaticResource Card}" Cursor="Hand" MouseLeftButtonUp="OnSurroundCardClick">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="SURROUND" />
                        <TextBlock FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Text="{Binding State.SurroundMode}" />
                    </StackPanel>
                </Border>
                <!-- Format -->
                <Border Margin="6,0,0,0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="FORMAT" />
                        <TextBlock FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Text="{Binding State.AudioFormat}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{StaticResource TextTertiaryBrush}"
                            Text="{Binding State.SampleRate, StringFormat='{}{0} sample rate'}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ── Volume & Channel matrix row ────────────────────────────── -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Master volume slider card -->
                <Border Grid.Column="0" Margin="0,0,6,0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="MASTER VOLUME" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:Button
                                Command="{Binding VolumeDownCommand}"
                                Icon="{ui:SymbolIcon Subtract24}"
                                ToolTip="Volume down" />
                            <Slider
                                Grid.Column="1"
                                Margin="12,0"
                                VerticalAlignment="Center"
                                IsMoveToPointEnabled="True"
                                LargeChange="1"
                                Maximum="150"
                                Minimum="0"
                                SmallChange="0.5"
                                TickFrequency="10"
                                TickPlacement="BottomRight"
                                Value="{Binding State.Main.Volume, Mode=TwoWay, Delay=250}" />
                            <ui:Button
                                Grid.Column="2"
                                Command="{Binding VolumeUpCommand}"
                                Icon="{ui:SymbolIcon Add24}"
                                ToolTip="Volume up" />
                        </Grid>
                        <UniformGrid Margin="0,16,0,0" Columns="3">
                            <StackPanel>
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{StaticResource TextTertiaryBrush}"
                                    Text="BASS" />
                                <TextBlock
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Text="{Binding State.Bass, StringFormat='{}{0:+#;-#;0} dB'}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{StaticResource TextTertiaryBrush}"
                                    Text="TREBLE" />
                                <TextBlock
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Text="{Binding State.Treble, StringFormat='{}{0:+#;-#;0} dB'}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{StaticResource TextTertiaryBrush}"
                                    Text="SUBWOOFER" />
                                <TextBlock
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Text="{Binding State.SubwooferLevel, StringFormat='{}{0:+#.#;-#.#;0} dB'}" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Channel matrix card -->
                <Border Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="INPUT SIGNAL" />
                        <!-- Spatial grid: mirrors how the receiver renders channels on-screen -->
                        <Grid
                            HorizontalAlignment="Center"
                            Margin="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Height row: FHL LFE ... EXT FHR -->
                            <controls:ChannelChip Grid.Row="0" Grid.Column="1" Channel="{Binding State.Channels[9]}"  Mode="InputSignal" />
                            <controls:ChannelChip Grid.Row="0" Grid.Column="2" Channel="{Binding State.Channels[21]}" Mode="InputSignal" />
                            <controls:ChannelChip Grid.Row="0" Grid.Column="4" Channel="{Binding State.Channels[22]}" Mode="InputSignal" />
                            <controls:ChannelChip Grid.Row="0" Grid.Column="5" Channel="{Binding State.Channels[10]}" Mode="InputSignal" />

                            <!-- Front row: FWL FL C FR FWR -->
                            <controls:ChannelChip Grid.Row="1" Grid.Column="0" Channel="{Binding State.Channels[19]}" Mode="InputSignal" />
                            <controls:ChannelChip Grid.Row="1" Grid.Column="1" Channel="{Binding State.Channels[0]}"  Mode="InputSignal" />
                            <controls:ChannelChip Grid.Row="1" Grid.Column="2" Channel="{Binding State.Channels[2]}"  Mode="InputSignal" />
                            <controls:ChannelChip Grid.Row="1" Grid.Column="4" Channel="{Binding State.Channels[1]}"  Mode="InputSignal" />
                            <controls:ChannelChip Grid.Row="1" Grid.Column="6" Channel="{Binding State.Channels[20]}" Mode="InputSignal" />

                            <!-- Side surrounds: SL / SR -->
                            <controls:ChannelChip Grid.Row="2" Grid.Column="1" Channel="{Binding State.Channels[4]}" Mode="InputSignal" />
                            <controls:ChannelChip Grid.Row="2" Grid.Column="5" Channel="{Binding State.Channels[5]}" Mode="InputSignal" />

                            <!-- Back surrounds: SBL SB SBR -->
                            <controls:ChannelChip Grid.Row="3" Grid.Column="1" Channel="{Binding State.Channels[6]}" Mode="InputSignal" />
                            <controls:ChannelChip Grid.Row="3" Grid.Column="2" Channel="{Binding State.Channels[8]}" Mode="InputSignal" />
                            <controls:ChannelChip Grid.Row="3" Grid.Column="5" Channel="{Binding State.Channels[7]}" Mode="InputSignal" />
                        </Grid>

                        <TextBlock Margin="0,24,0,0" Style="{StaticResource Caption}" Text="ACTIVE SPEAKERS" />
                        <TextBlock
                            Margin="0,0,0,4"
                            FontSize="11"
                            Foreground="{StaticResource TextTertiaryBrush}"
                            Text="Click a speaker to adjust its trim" />

                        <!-- Simpler layout since only physical speakers matter here -->
                        <Grid HorizontalAlignment="Center" Margin="0,4,0,0" controls:ChannelChip.ChipClicked="OnSpeakerClicked">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <controls:ChannelChip Grid.Row="0" Grid.Column="1" Channel="{Binding State.Channels[3]}" Mode="ActiveSpeaker" />

                            <controls:ChannelChip Grid.Row="1" Grid.Column="0" Channel="{Binding State.Channels[0]}" Mode="ActiveSpeaker" />
                            <controls:ChannelChip Grid.Row="1" Grid.Column="1" Channel="{Binding State.Channels[2]}" Mode="ActiveSpeaker" />
                            <controls:ChannelChip Grid.Row="1" Grid.Column="2" Channel="{Binding State.Channels[1]}" Mode="ActiveSpeaker" />

                            <controls:ChannelChip Grid.Row="2" Grid.Column="0" Channel="{Binding State.Channels[4]}" Mode="ActiveSpeaker" />
                            <controls:ChannelChip Grid.Row="2" Grid.Column="2" Channel="{Binding State.Channels[5]}" Mode="ActiveSpeaker" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── Source selector popup ──────────────────────────────────── -->
            <Popup
                x:Name="SourcePopup"
                AllowsTransparency="True"
                Placement="MousePoint"
                StaysOpen="False">
                <Border
                    Padding="12"
                    Background="{StaticResource Surface1Brush}"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1.5"
                    CornerRadius="12"
                    MaxHeight="400">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" Opacity="0.5" ShadowDepth="4" Color="Black" />
                    </Border.Effect>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="380">
                        <ItemsControl ItemsSource="{Binding State.Sources}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        Margin="0,2"
                                        Padding="12,8"
                                        HorizontalContentAlignment="Left"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="OnSourcePopupClick"
                                        Cursor="Hand"
                                        Tag="{Binding Token}">
                                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Caption}" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Popup>

            <!-- ── Surround mode selector popup ──────────────────────────── -->
            <Popup
                x:Name="SurroundPopup"
                AllowsTransparency="True"
                Placement="MousePoint"
                StaysOpen="False">
                <Border
                    Padding="12"
                    Background="{StaticResource Surface1Brush}"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1.5"
                    CornerRadius="12"
                    MaxHeight="450">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" Opacity="0.5" ShadowDepth="4" Color="Black" />
                    </Border.Effect>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420">
                        <StackPanel x:Name="SurroundList" />
                    </ScrollViewer>
                </Border>
            </Popup>

            <!-- ── Trim popup ────────────────────────────────────────────── -->
            <Popup
                x:Name="TrimPopup"
                AllowsTransparency="True"
                Placement="MousePoint"
                StaysOpen="False">
                <Border
                    Padding="18"
                    Background="{StaticResource Surface1Brush}"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1.5"
                    CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="24"
                            Opacity="0.6"
                            ShadowDepth="6"
                            Color="Black" />
                    </Border.Effect>
                    <StackPanel Width="280">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{StaticResource TextTertiaryBrush}"
                                    Text="SPEAKER" />
                                <TextBlock
                                    x:Name="TrimTitle"
                                    FontSize="18"
                                    FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock
                                x:Name="TrimValue"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="22"
                                FontWeight="Bold"
                                Foreground="{StaticResource AccentBrush}" />
                        </Grid>
                        <Slider
                            x:Name="TrimSlider"
                            IsMoveToPointEnabled="True"
                            LargeChange="0.5"
                            Maximum="12"
                            Minimum="-12"
                            SmallChange="0.5"
                            TickFrequency="3"
                            TickPlacement="BottomRight"
                            ValueChanged="OnTrimChanged" />
                        <TextBlock
                            Margin="0,8,0,0"
                            FontSize="11"
                            Foreground="{StaticResource TextTertiaryBrush}"
                            Text="Per-channel trim · 0.5 dB steps · range ±12 dB" />
                    </StackPanel>
                </Border>
            </Popup>
        </StackPanel>
    </ScrollViewer>
</pages:PageBase>


