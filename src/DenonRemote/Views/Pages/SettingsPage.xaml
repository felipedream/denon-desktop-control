<pages:PageBase
    x:Class="DenonRemote.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:DenonRemote.Views.Pages"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    mc:Ignorable="d">

    <pages:PageBase.Resources>
        <!-- Divider between compact rows inside a card -->
        <Style x:Key="RowLine" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="Margin" Value="0,10" />
        </Style>
    </pages:PageBase.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="TitleText" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock x:Name="SubtitleText" Style="{StaticResource Subtitle}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- ── Preferences (single card, compact rows) ────────────────── -->
            <Border Grid.Column="0" Margin="0,0,6,0" Padding="20" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Margin="0,0,0,4" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="Preferencias" />

                    <!-- Auto-connect -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="AutoConnLabel" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock x:Name="AutoConnDesc" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.AutoConnect, Mode=TwoWay}" />
                    </Grid>

                    <Border Style="{StaticResource RowLine}" />

                    <!-- Close to tray -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="TrayLabel" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock x:Name="TrayDesc" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.CloseToTray, Mode=TwoWay}" />
                    </Grid>

                    <Border Style="{StaticResource RowLine}" />

                    <!-- Start minimized -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="MinLabel" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock x:Name="MinDesc" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.StartMinimized, Mode=TwoWay}" />
                    </Grid>

                    <Border Style="{StaticResource RowLine}" />

                    <!-- Auto-update -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="UpdateLabel" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock x:Name="UpdateDesc" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.AutoUpdate, Mode=TwoWay}" />
                    </Grid>

                    <Border Style="{StaticResource RowLine}" />

                    <!-- Volume unit -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="UnitLabel" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock x:Name="UnitDesc" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            MinWidth="180"
                            VerticalAlignment="Center"
                            DisplayMemberPath="Caption"
                            ItemsSource="{Binding VolumeUnits}"
                            SelectedItem="{Binding SelectedVolumeUnit, Mode=TwoWay}" />
                    </Grid>

                    <!-- Update banner, only when a newer version exists -->
                    <Border
                        Margin="0,14,0,0"
                        Padding="14,12"
                        Background="{StaticResource Surface2Brush}"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Visibility="{Binding AvailableUpdate, Converter={StaticResource NotNullToBool}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}">
                                    <Run x:Name="UpdateAvailRun" />
                                    <Run Text="{Binding AvailableUpdate.Version}" />
                                </TextBlock>
                                <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding AvailableUpdate.Notes}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ui:Button
                                Grid.Column="1"
                                Appearance="Primary"
                                Click="OnUpdateClick"
                                Content="Descargar"
                                Icon="{ui:SymbolIcon ArrowSync24}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ── About ──────────────────────────────────────────────────── -->
            <Border Grid.Column="1" Margin="6,0,0,0" Padding="20" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <!-- App identity -->
                    <StackPanel Orientation="Horizontal">
                        <Border
                            Width="40"
                            Height="40"
                            Background="{StaticResource AccentBrush}"
                            CornerRadius="10">
                            <ui:SymbolIcon FontSize="20" Foreground="White" Symbol="Speaker224" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="DENON Desktop Control" />
                            <TextBlock x:Name="VersionText" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock
                        x:Name="FreeVersionText"
                        Margin="0,14,0,0"
                        FontSize="12"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        TextWrapping="Wrap" />

                    <Border Style="{StaticResource RowLine}" Margin="0,14" />

                    <!-- Author -->
                    <TextBlock x:Name="CreatedByLabel" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextTertiaryBrush}" />
                    <TextBlock Margin="0,2,0,0" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="Felipe" />
                    <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Text="Buin, Santiago de Chile" />

                    <!-- Links -->
                    <ui:Button
                        x:Name="TelegramBtn"
                        Margin="0,14,0,6"
                        HorizontalAlignment="Stretch"
                        Click="OnTelegramClick"
                        Icon="{ui:SymbolIcon Send24}" />
                    <ui:Button
                        x:Name="DonateBtn"
                        HorizontalAlignment="Stretch"
                        Appearance="Primary"
                        Click="OnDonateClick"
                        Icon="{ui:SymbolIcon Heart24}" />

                    <Border Style="{StaticResource RowLine}" Margin="0,14" />

                    <TextBlock
                        FontSize="10"
                        Foreground="{StaticResource TextTertiaryBrush}"
                        Text="MIT License - Codigo abierto"
                        TextWrapping="Wrap" />
                    <TextBlock
                        FontSize="10"
                        Foreground="{StaticResource TextTertiaryBrush}"
                        Text="github.com/felipedream/denon-desktop-control"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</pages:PageBase>
