<pages:PageBase
    x:Class="DenonRemote.Views.Pages.SoundPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="clr-namespace:DenonRemote.Views.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="900">

            <TextBlock FontSize="28" FontWeight="Bold" Text="Sound" />
            <TextBlock Margin="0,4,0,20" Opacity="0.7" Text="Tone control, subwoofer trim and DSP" />

            <Border Margin="0,0,0,16" Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Tone control" />
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding State.ToneControlEnabled, Mode=TwoWay}" />
                    </Grid>

                    <TextBlock FontSize="12" Opacity="0.6" Text="BASS" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <Slider
                            IsEnabled="{Binding State.ToneControlEnabled}"
                            LargeChange="1"
                            Maximum="6"
                            Minimum="-6"
                            SmallChange="1"
                            TickFrequency="1"
                            TickPlacement="BottomRight"
                            Value="{Binding State.Bass, Mode=TwoWay, Delay=200}" />
                        <TextBlock
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="{Binding State.Bass, StringFormat='{}{0:+#;-#;0} dB'}" />
                    </Grid>

                    <TextBlock FontSize="12" Opacity="0.6" Text="TREBLE" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <Slider
                            IsEnabled="{Binding State.ToneControlEnabled}"
                            LargeChange="1"
                            Maximum="6"
                            Minimum="-6"
                            SmallChange="1"
                            TickFrequency="1"
                            TickPlacement="BottomRight"
                            Value="{Binding State.Treble, Mode=TwoWay, Delay=200}" />
                        <TextBlock
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="{Binding State.Treble, StringFormat='{}{0:+#;-#;0} dB'}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Subwoofer trim" />
                    <TextBlock Margin="0,2,0,12" Opacity="0.6" Text="Adjusts the subwoofer output in 0.5 dB steps." />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <Slider
                            LargeChange="0.5"
                            Maximum="12"
                            Minimum="-12"
                            SmallChange="0.5"
                            TickFrequency="3"
                            TickPlacement="BottomRight"
                            Value="{Binding State.SubwooferLevel, Mode=TwoWay, Delay=200}" />
                        <TextBlock
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="{Binding State.SubwooferLevel, StringFormat='{}{0:+#.#;-#.#;0} dB'}" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</pages:PageBase>



