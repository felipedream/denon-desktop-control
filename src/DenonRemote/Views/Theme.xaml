<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:DenonRemote.Converters">

    <!-- ══════════ Brand palette ══════════
         Warm carmine that pops on the dark canvas. -->
    <Color x:Key="AccentColor">#E63946</Color>
    <Color x:Key="AccentColorLight1">#F1596A</Color>
    <Color x:Key="AccentColorLight2">#F58390</Color>
    <Color x:Key="AccentColorDark1">#C4222E</Color>
    <Color x:Key="AccentColorDark2">#9E1B24</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentColorLight1}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentColorDark1}" />

    <!-- Channel matrix colors -->
    <Color x:Key="ActiveSpeakerColor">#E63946</Color>
    <Color x:Key="IdleSpeakerColor">#2F3238</Color>
    <SolidColorBrush x:Key="ActiveSpeakerBrush" Color="{StaticResource ActiveSpeakerColor}" />
    <SolidColorBrush x:Key="IdleSpeakerBrush" Color="{StaticResource IdleSpeakerColor}" />
    <SolidColorBrush x:Key="ChannelActiveTextBrush" Color="White" />
    <SolidColorBrush x:Key="ChannelIdleTextBrush" Color="#9096A0" />

    <!-- ══════════ Surfaces ══════════
         Semi-transparent tones so Mica/Acrylic bleeds through subtly. -->
    <SolidColorBrush x:Key="Surface0Brush" Color="#0B0D11" />
    <SolidColorBrush x:Key="Surface1Brush" Color="#181B22" Opacity="0.85" />
    <SolidColorBrush x:Key="Surface2Brush" Color="#20242D" Opacity="0.80" />
    <SolidColorBrush x:Key="NavBrush"      Color="#0F1116" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#2C313A" Opacity="0.7" />
    <SolidColorBrush x:Key="StrongBorderBrush" Color="#3A4049" />

    <!-- ══════════ Text ══════════
         WPF-UI's Dark theme ships primary text at ~0.9 alpha on Fluent black
         which loses contrast on top of Mica. We override the ramp with values
         tuned for legibility (WCAG 4.5:1+ on Surface0). -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C7CBD1" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8B919B" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#5A5F68" />

    <!-- WPF-UI Fluent brush names — overridden so every packaged control
         (buttons, toggles, cards, headers) inherits our contrast. -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#C7CBD1" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#8B919B" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#5A5F68" />

    <!-- ══════════ Converters ══════════ -->
    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
    <conv:BoolToColorConverter x:Key="ChannelBg"
                               TrueBrush="{StaticResource ActiveSpeakerBrush}"
                               FalseBrush="{StaticResource IdleSpeakerBrush}" />
    <conv:BoolToColorConverter x:Key="ChannelFg"
                               TrueBrush="{StaticResource ChannelActiveTextBrush}"
                               FalseBrush="{StaticResource ChannelIdleTextBrush}" />
    <conv:VolumeLabelConverter x:Key="VolumeLabel" />
    <conv:NotNullToBoolConverter x:Key="NotNullToBool" />
    <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVis" />
    <conv:ZeroToVisibleConverter x:Key="ZeroToVisible" />
    <conv:NotZeroToVisibleConverter x:Key="NotZeroToVisible" />
    <conv:EmptyToVisibleConverter x:Key="EmptyToVisible" />
    <conv:FolderIconConverter x:Key="FolderIcon" />
    <conv:ViewWidthConverter x:Key="ViewWidth" />
    <conv:ViewHeightConverter x:Key="ViewHeight" />
    <conv:MuteIconConverter x:Key="MuteIcon" />
    <conv:MuteBrushConverter x:Key="MuteBrush"
                             MutedBrush="{StaticResource AccentBrush}"
                             NormalBrush="{StaticResource TextPrimaryBrush}" />
    <conv:PlayPauseIconConverter x:Key="PlayPauseIcon" />
    <conv:HeosStatusConverter x:Key="HeosStatus" />
    <conv:AvailableBrushConverter x:Key="AvailableBrush"
                                  AvailableBrush="{StaticResource TextPrimaryBrush}"
                                  UnavailableBrush="{StaticResource TextTertiaryBrush}" />

    <!-- ══════════ Typography ══════════ -->
    <FontFamily x:Key="UiFont">Segoe UI Variable, Segoe UI, Segoe UI Emoji</FontFamily>

    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="Subtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="MetricValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- ══════════ Card ══════════ -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface1Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="22" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect
                    BlurRadius="18"
                    Direction="270"
                    Opacity="0.35"
                    ShadowDepth="4"
                    Color="Black" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="InsetCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
        <Setter Property="Effect" Value="{x:Null}" />
    </Style>

    <!-- Small pill for the signal / speaker matrix -->
    <Style x:Key="ChannelChip" TargetType="Border">
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ══════════ Default TextBlock ══════════
         Applies our contrast to every unstyled TextBlock so the pages read
         well even before per-element styling. -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>
</ResourceDictionary>
